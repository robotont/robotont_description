<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="robotont_gen3">
    <xacro:include filename="$(find robotont_description)/urdf/shared/rim.urdf.xacro"/>
    <xacro:include filename="$(find robotont_description)/urdf/gen3/motor.urdf.xacro"/>
    <xacro:include filename="$(find robotont_description)/urdf/gen3/nuc.urdf.xacro"/>
    <xacro:include filename="$(find robotont_description)/urdf/gen3/camera.urdf.xacro"/>
    <xacro:include filename="$(find robotont_description)/urdf/gen3/base.urdf.xacro"/>
    <xacro:include filename="$(find robotont_description)/urdf/gen3/button.urdf.xacro"/>

    <xacro:arg name="prefix" default=""/>
    <xacro:property name="prefix" value="$(arg prefix)"/>

    <xacro:property name="wheel_distance_back" value="0.14"/>
    <xacro:property name="wheel_distance_front" value="0.16"/>
    <xacro:property name="wheel_center_height" value="0.021"/>
    <xacro:property name="roller_color" value="0.61 0.55 0.49 1.0"/>
    <xacro:property name="rim_color" value="0.26 0.26 0.26 1.0"/>
    <xacro:property name="wheel_z_rotation_offset" value="${5.613 * (pi / 180)}"/>
    <xacro:property name="wheel_length" value="${0.0225}"/>

    <xacro:property name="frame_height" value="0.065"/>
    <xacro:property name="frame_ground_clearance" value="0.014"/>
    <xacro:property name="frame_thickness" value="0.000025"/>
    <xacro:property name="base_color" value="0.16 0.65 0.98 1.0"/>

    <xacro:property name="nuc_frame_color" value="0.75 0.75 0.75 1.0"/>

    <link name="${prefix}base_footprint"/>

    <!-- Frame module -->
    <xacro:base_macro
        color="${base_color}"
        frame_height="${frame_height}"
        frame_ground_clearance="${frame_ground_clearance}"
        prefix="${prefix}"
    />

    <!-- Motor modules -->
    <xacro:motor_macro
        name="back"
        color="${rim_color}"
        angle="${-3 * pi / 2}"
        z_rotation_offset="0"
        wheel_center_height="${wheel_center_height}"
        wheel_length="${wheel_length}"
        frame_ground_clearance="${frame_ground_clearance}"
        frame_thickness="${frame_thickness}"
        distance="${-wheel_distance_back}"
        gap="0.0025"
        prefix="${prefix}"
    />

    <xacro:motor_macro
        name="right"
        color="${rim_color}"
        angle="${-143.5 * (pi/180)}"
        z_rotation_offset="${-wheel_z_rotation_offset}"
        wheel_center_height="${wheel_center_height}"
        wheel_length="${wheel_length}"
        frame_ground_clearance="${frame_ground_clearance}"
        frame_thickness="${frame_thickness}"
        distance="${-wheel_distance_front}"
        gap="0"
        prefix="${prefix}"
    />

    <xacro:motor_macro
        name="left"
        color="${rim_color}"
        angle="${-36.5 * (pi/180)}"
        z_rotation_offset="${wheel_z_rotation_offset}"
        wheel_center_height="${wheel_center_height}"
        wheel_length="${wheel_length}"
        frame_ground_clearance="${frame_ground_clearance}"
        frame_thickness="${frame_thickness}"
        distance="${-wheel_distance_front}"
        gap="0"
        prefix="${prefix}"
    />

    <!-- Wheels -->
    <xacro:rim_macro
        name="back"
        color="${rim_color}"
        roller_color="${roller_color}"
        angle="${3*pi/2}"
        wheel_distance="${wheel_distance_back}"
        wheel_center_height="${wheel_center_height}"
        z_rotation_offset="0"
        prefix="${prefix}"
    />
    <xacro:rim_macro
        name="right"
        color="${rim_color}"
        roller_color="${roller_color}"
        angle="${145 * (pi/180)}"
        wheel_distance="${wheel_distance_front}"
        wheel_center_height="${wheel_center_height}"
        z_rotation_offset="${wheel_z_rotation_offset}"
        prefix="${prefix}"

    />
    <xacro:rim_macro
        name="left"
        color="${rim_color}"
        roller_color="${roller_color}"
        angle="${35 * (pi/180)}"
        wheel_distance="${wheel_distance_front}"
        wheel_center_height="${wheel_center_height}"
        z_rotation_offset="${-wheel_z_rotation_offset}"
        prefix="${prefix}"
    />

    <!-- Computer module -->
    <xacro:nuc_macro
        color="${nuc_frame_color}"
        frame_height="${frame_height}"
        frame_ground_clearance="${frame_ground_clearance}"
        prefix="${prefix}"
    />

    <!-- Camera module -->
    <xacro:camera_macro
        color="${nuc_frame_color}"
        frame_height="${frame_height}"
        frame_ground_clearance="${frame_ground_clearance}"
        prefix="${prefix}"
    />

    <!-- E-button -->
    <xacro:e_button_macro
        color="1.0 0 0 1.0"
        frame_height="${frame_height}"
        frame_ground_clearance="${frame_ground_clearance}"
        prefix="${prefix}"
    />
</robot>
